android_app {
    name: "ExtraVisionPrivate",
    srcs: ["src/**/*.java", "src/**/*.kt"],
    static_libs: [
        "androidx.core_core",
        "androidx.appcompat_appcompat",
        "setup-wizard-lib",
        "setupcompat",
        "setupdesign",
        "vendor.extra.biometrics.face-V2-java",
    ],
    platform_apis: true,
    privileged: true,
    certificate: "platform",
    optimize: {
        enabled: false,
    },
    compile_dex: true,
    installable: false,
}

android_app_import {
    name: "ExtraVision",
    apk: ":ExtraVisionPrivate{.apk}",
    privileged: true,
    vendor: true,
    required: [
        "privapp_whitelist_org.extra.vision.xml",
        "ExtraVisionOverlay",
    ],
    preprocessed: true,
    dex_preopt: {
        enabled: false,
    },
}
